# Required: authenticates the admin API and the CLI. openssl rand -hex 32
SKOPE_ADMIN_TOKEN=

# Optional: sync only some ecosystems (default: Hex,crates.io,RubyGems,npm,Go,PyPI)
# SKOPE_ECOSYSTEMS=Hex,npm

# Email alerts (every new and resolved finding). Port 465 = implicit TLS, else STARTTLS.
SKOPE_SMTP_ADDR=
SKOPE_SMTP_USER=
SKOPE_SMTP_PASSWORD=
SKOPE_EMAIL_FROM=
SKOPE_EMAIL_TO=

# Phone alerts via ntfy (malicious packages, high/critical, unrated)
SKOPE_NTFY_TOPIC=
# SKOPE_NTFY_URL=https://ntfy.sh
SKOPE_NTFY_TOKEN=

# Continuous backup with Litestream to S3-compatible storage. Leave the URL
# empty to run without backups. On an empty volume, the database is restored
# from the replica first; if the replica can't be reached, skope won't start
# rather than start empty.
# Linode Object Storage example:
# LITESTREAM_REPLICA_URL=s3://my-bucket/skope.db?endpoint=us-east-1.linodeobjects.com&region=us-east-1
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
